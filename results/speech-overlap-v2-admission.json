    {
      "id": "overlap_backchannel_the_cold_knee",
      "kind": "backchannel",
      "original_agent_seconds": 19.264,
      "boundary_seconds": 9.8,
      "simultaneous_rms_active_seconds": 0.58,
      "episode_seconds": 28.085333333333335,
      "placements": [
        {
          "role": "user",
          "content": "Do you ever regret choosing somewhere so far uphill?",
          "wav": "overlap_backchannel_the_cold_knee-00.wav",
          "voice": "af_heart",
          "gap_ms": 400,
          "duration_seconds": 2.688,
          "render_seconds": 0.6003221249993658,
          "wav_sha256": "c430297e4bf3871742907e10b94b4ad739a91014f7649b467e9231e0952f92a2",
          "start_seconds": 0.4,
          "end_seconds": 3.088,
          "channel": 1
        },
        {
          "role": "assistant",
          "content": "My knee has opinions about it when the weather turns cold. I sometimes stop halfway down the path and pretend to be admiring the view. Usually I am, but I am also waiting for the knee to finish its complaint. I can like living here and still wish the rice would carry itself home from the village.",
          "wav": "overlap_backchannel_the_cold_knee-01.wav",
          "voice": "bm_george",
          "gap_ms": 400,
          "duration_seconds": 19.264,
          "render_seconds": 3.747972417011624,
          "wav_sha256": "d14976b9e93b56ea2f2de1382c24ba801a9ca8c1b0bf9206bea618efabd69ff1",
          "start_seconds": 3.488,
          "end_seconds": 22.752,
          "channel": 0
        },
        {
          "role": "user",
          "content": "Yes, fair enough.",
          "wav": "overlap_backchannel_the_cold_knee-02.wav",
          "voice": "af_heart",
          "gap_ms": -9463.999999999998,
          "duration_seconds": 1.088,
          "render_seconds": 0.319802708007046,
          "wav_sha256": "49bc7f8fb788feaf0f01b1abcb4869e45bc83b22cf6a66df065fb3b93d61abe5",
          "start_seconds": 13.288,
          "end_seconds": 14.376,
          "channel": 1
        },
        {
          "role": "assistant",
          "content": "So far the rice has declined every invitation.",
          "wav": "overlap_backchannel_the_cold_knee-03.wav",
          "voice": "bm_george",
          "gap_ms": 8655.999999999996,
          "duration_seconds": 4.053333333333334,
          "render_seconds": 0.8431720839871559,
          "wav_sha256": "8f20328437e3d80fab1f52100992ace31151f858d1d2fc1f9a4d2ac2904d7ca9",
          "start_seconds": 23.032,
          "end_seconds": 27.085333333333335,
          "channel": 0
        }
      ],
      "word_corrections": [],
      "last_agent_word_after_caller_end_seconds": 7.952
