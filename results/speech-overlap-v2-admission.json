    {
      "id": "overlap_backchannel_mara_broom",
      "kind": "backchannel",
      "original_agent_seconds": 19.84,
      "boundary_seconds": 10.0,
      "simultaneous_rms_active_seconds": 1.22,
      "episode_seconds": 29.578666666666667,
      "placements": [
        {
          "role": "user",
          "content": "Was Mara patient with you when you were new?",
          "wav": "overlap_backchannel_mara_broom-00.wav",
          "voice": "am_michael",
          "gap_ms": 400,
          "duration_seconds": 2.7946666666666666,
          "render_seconds": 0.6401964999968186,
          "wav_sha256": "1c1c2c44c36448e843a2835dbd6abb3c6e5118b83db3dedc1a2ce1511c4c9484",
          "start_seconds": 0.4,
          "end_seconds": 3.1946666666666665,
          "channel": 1
        },
        {
          "role": "assistant",
          "content": "More patient than I understood at the time. I thought patience ought to sound encouraging. Sometimes her patience sounded like asking me to finish sweeping before announcing what I had learned from sweeping. She did not need me to be impressive every morning. It took me a while to discover how much kindness there was in that.",
          "wav": "overlap_backchannel_mara_broom-01.wav",
          "voice": "bm_george",
          "gap_ms": 400,
          "duration_seconds": 19.84,
          "render_seconds": 3.992419875008636,
          "wav_sha256": "b0e532a8d1a2a030bb47181901366659afcf11fe8973edd9262933434f7822f3",
          "start_seconds": 3.5946666666666665,
          "end_seconds": 23.434666666666665,
          "channel": 0
        },
        {
          "role": "user",
          "content": "Yes, I understand.",
          "wav": "overlap_backchannel_mara_broom-02.wav",
          "voice": "am_michael",
          "gap_ms": -9840.0,
          "duration_seconds": 1.4506666666666668,
          "render_seconds": 0.40418262500315905,
          "wav_sha256": "cb735315dd474eb7003c180b497d95f6554901d20a2ddb735ff9518a6cab9d01",
          "start_seconds": 13.594666666666667,
          "end_seconds": 15.045333333333334,
          "channel": 1
        },
        {
          "role": "assistant",
          "content": "I still miss her. Remembering that particular look can make me laugh, though.",
          "wav": "overlap_backchannel_mara_broom-03.wav",
          "voice": "bm_george",
          "gap_ms": 8669.333333333332,
          "duration_seconds": 4.864,
          "render_seconds": 1.209202208003262,
          "wav_sha256": "029515a83d0848ca70fba6d38b760861f1e050da7f48beb7f1740ff2f2f5fd86",
          "start_seconds": 23.714666666666666,
          "end_seconds": 28.578666666666667,
          "channel": 0
        }
      ],
      "word_corrections": [],
      "last_agent_word_after_caller_end_seconds": 8.049333333333331
    },
    {
      "id": "overlap_backchannel_salty_pot",
      "kind": "backchannel",
      "original_agent_seconds": 22.677333333333333,
      "boundary_seconds": 11.36,
      "simultaneous_rms_active_seconds": 0.8,
      "episode_seconds": 32.565333333333335,
      "placements": [
        {
          "role": "user",
          "content": "Tell me about something you got wrong in the kitchen.",
          "wav": "overlap_backchannel_salty_pot-00.wav",
          "voice": "af_heart",
          "gap_ms": 400,
          "duration_seconds": 2.304,
          "render_seconds": 0.529773957998259,
          "wav_sha256": "5165da9be158ce433e95a744bd297fddc3fc6a940189ad31c80d4c95e27e6612",
          "start_seconds": 0.4,
          "end_seconds": 2.704,
          "channel": 1
        },
        {
          "role": "assistant",
          "content": "I salted a pot twice because I forgot I had already done it. Then I added more lentils, which required more water, which required a larger pot. By supper I had managed to turn a small mistake into enough food for several people. I carried some down to a neighbour and tried very hard not to describe the meal as a generous plan I had formed that morning.",
          "wav": "overlap_backchannel_salty_pot-01.wav",
          "voice": "bm_george",
          "gap_ms": 400,
          "duration_seconds": 22.677333333333333,
          "render_seconds": 5.00476445798995,
          "wav_sha256": "a00118db5b230f51c45a74abfc4db09bfbbeb46db632368a005bf696d739c6a0",
          "start_seconds": 3.104,
          "end_seconds": 25.781333333333333,
          "channel": 0
        },
        {
          "role": "user",
          "content": "That makes sense.",
          "wav": "overlap_backchannel_salty_pot-02.wav",
          "voice": "af_heart",
          "gap_ms": -11317.333333333334,
          "duration_seconds": 1.0666666666666667,
          "render_seconds": 0.35543437500018626,
          "wav_sha256": "2963b15d76f7469a88e0a00a676d86e3a7988ce2b4f3c773c4367063e550cd0d",
          "start_seconds": 14.464,
          "end_seconds": 15.530666666666667,
          "channel": 1
        },
        {
          "role": "assistant",
          "content": "It was edible in the end. I consider that a satisfactory ending for lentils.",
          "wav": "overlap_backchannel_salty_pot-03.wav",
          "voice": "bm_george",
          "gap_ms": 10530.666666666666,
          "duration_seconds": 5.504,
          "render_seconds": 1.1778262499865377,
          "wav_sha256": "c9d2a877472aca734633cd9da4639badf8d2c5a640892461a78cb7a0ac78dea9",
          "start_seconds": 26.061333333333334,
          "end_seconds": 31.565333333333335,
          "channel": 0
        }
      ],
      "word_corrections": [],
      "last_agent_word_after_caller_end_seconds": 9.833333333333334
